<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.windowsnetworkmanager.scanner</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/wnm-scanner</string>
		<string>-web</string>
		<string>-port</string>
		<string>18081</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/hanifm/Library/Logs/wnm-scanner/out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/hanifm/Library/Logs/wnm-scanner/error.log</string>
	<key>WorkingDirectory</key>
	<string>/usr/local/bin</string>
</dict>
</plist>
